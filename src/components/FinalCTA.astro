<section class="relative overflow-hidden py-24 lg:py-32">
  <div class="absolute inset-0 bg-linear-to-br from-electric-teal via-midnight-blue to-soft-lilac" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(255,255,255,0.1),transparent_50%)]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-4xl px-6 text-center lg:px-8">
    <h2 class="font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
      Ready to launch your community?
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-white/90">
      Join creators, coaches, and organizations building paid communities on Atzora.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="mailto:support@atzora.app?subject=Book%20a%20Demo"
        class="inline-flex items-center rounded-full bg-white px-8 py-3.5 text-sm font-semibold text-midnight-blue shadow-xl transition hover:-translate-y-0.5 hover:shadow-2xl"
      >
        Book a Demo
      </a>
      <a
        href="https://app.atzora.app"
        class="inline-flex items-center rounded-full border border-white/30 bg-white/10 px-8 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/20"
      >
        Login to App
      </a>
    </div>
  </div>
</section>

<section class="py-12">
  <div class="mx-auto max-w-3xl px-6 text-center lg:px-8">
    <p class="text-sm leading-relaxed text-medium-gray">
      Businesses using Atzora charge recurring subscription fees or membership payments in exchange for access to
      content, communities, and digital experiences.
    </p>
  </div>
</section>
