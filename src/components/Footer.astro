<footer class="border-t border-midnight-blue/5 bg-off-black text-white">
  <div class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div>
        <div class="font-display text-2xl font-bold tracking-tight">Atzora</div>
        <a
          href="mailto:support@atzora.app"
          class="mt-3 inline-block text-sm text-white/85 transition hover:text-electric-teal"
        >
          support@atzora.app
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/75">
          A creator-first community & membership platform for paid access, private communities, and digital experiences.
        </p>
      </div>

      <div class="flex flex-col gap-3 text-sm">
        <span class="font-medium text-white/80">Legal</span>
        <a href="/privacy" class="text-white/80 transition hover:text-electric-teal">Privacy Policy</a>
        <a href="/terms" class="text-white/80 transition hover:text-electric-teal">Terms of Service</a>
      </div>

      <div class="flex flex-col gap-3 text-sm">
        <span class="font-medium text-white/80">Product</span>
        <a href="https://app.atzora.app" class="text-white/80 transition hover:text-electric-teal">Login</a>
        <a
          href="mailto:support@atzora.app?subject=Book%20a%20Demo"
          class="text-white/80 transition hover:text-electric-teal"
        >
          Book a Demo
        </a>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-center text-xs text-white/65">
      &copy; {new Date().getFullYear()} Atzora. All rights reserved.
    </div>
  </div>
</footer>
