---
const steps = [
  {
    number: '01',
    title: 'Create your community',
    description: 'Set up your branded space with custom join pages and member onboarding flows.',
  },
  {
    number: '02',
    title: 'Set up memberships',
    description: 'Configure tiers, pricing, and Stripe-powered checkout for subscriptions and one-time purchases.',
  },
  {
    number: '03',
    title: 'Invite members & deliver',
    description: 'Launch your member portal with content libraries, live sessions, and community discussions.',
  },
];
---

<section id="how-it-works" class="bg-arctic-white py-24 lg:py-32">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="mb-16 text-center">
      <span class="text-sm font-semibold uppercase tracking-widest text-electric-teal">How it works</span>
      <h2 class="mt-3 font-display text-3xl font-bold text-midnight-blue sm:text-4xl">
        Launch in three steps
      </h2>
    </div>

    <div class="relative grid gap-8 md:grid-cols-3">
      <div
        class="absolute left-0 right-0 top-12 hidden h-0.5 bg-linear-to-r from-electric-teal via-soft-lilac to-coral-bliss md:block"
        aria-hidden="true"
      />

      {
        steps.map((step) => (
          <article class="relative text-center">
            <div class="relative z-10 mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-2xl bg-white shadow-lg shadow-midnight-blue/5">
              <span class="font-display text-2xl font-bold text-electric-teal">{step.number}</span>
            </div>
            <h3 class="font-display text-xl font-bold text-midnight-blue">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-medium-gray">{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
