---
const integrations = [
  { name: 'Stripe', description: 'Payments & subscriptions' },
  { name: 'SMS', description: 'Twilio & compliant opt-in' },
  { name: 'Email', description: 'Member communications' },
];
---

<section class="border-y border-midnight-blue/5 bg-white py-16">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:justify-between">
      <div class="text-center lg:text-left">
        <span class="text-sm font-semibold uppercase tracking-widest text-electric-teal">Integrations</span>
        <h2 class="mt-2 font-display text-2xl font-bold text-midnight-blue sm:text-3xl">
          Built for compliance &amp; scale
        </h2>
        <p class="mt-3 max-w-md text-medium-gray">
          Stripe-powered payments with audit-ready SMS consent records for community communications.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-4">
        {
          integrations.map((item) => (
            <div class="flex items-center gap-3 rounded-2xl border border-midnight-blue/5 bg-arctic-white px-6 py-4 shadow-sm">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-white font-display text-sm font-bold text-midnight-blue shadow-sm">
                {item.name.slice(0, 1)}
              </div>
              <div>
                <div class="font-display font-semibold text-midnight-blue">{item.name}</div>
                <div class="text-xs text-medium-gray">{item.description}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
