---
const props = [
  {
    title: 'Recurring Memberships',
    description: 'Sell recurring memberships and subscription access with flexible tiers.',
    icon: '🔄',
    accent: 'border-l-electric-teal',
  },
  {
    title: 'Private Communities',
    description: 'Host private, member-only community spaces your audience will love.',
    icon: '🔒',
    accent: 'border-l-soft-lilac',
  },
  {
    title: 'Digital Access',
    description: 'Deliver exclusive content, courses, and experiences to members.',
    icon: '✨',
    accent: 'border-l-coral-bliss',
  },
];
---

<section class="py-20">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-3">
      {
        props.map((item) => (
          <article class="group rounded-2xl border border-midnight-blue/5 border-l-4 bg-white p-8 shadow-sm transition hover:-translate-y-1 hover:shadow-lg hover:shadow-midnight-blue/5">
            <span class:list={['mb-4 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-arctic-white text-3xl', item.accent]}>
              {item.icon}
            </span>
            <h3 class="font-display text-xl font-bold text-midnight-blue">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-medium-gray">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
